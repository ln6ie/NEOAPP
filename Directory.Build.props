<Project>
  <PropertyGroup>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <LangVersion>14</LangVersion>
    <Product>NEO</Product>
    <Company>NEO contributors</Company>
    <Description>Native Windows floating AI assistant powered by llama.cpp.</Description>
    <!-- Keep generated build files outside the source tree. -->
    <NEOBuildRoot>$(MSBuildThisFileDirectory)..\NEOAPP.build\</NEOBuildRoot>
    <BaseOutputPath>$(NEOBuildRoot)bin\</BaseOutputPath>
    <BaseIntermediateOutputPath>$(NEOBuildRoot)obj\$(MSBuildProjectName)\</BaseIntermediateOutputPath>
  </PropertyGroup>
</Project>
