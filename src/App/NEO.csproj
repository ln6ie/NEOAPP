<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>NEO</AssemblyName>
    <RootNamespace>NEO</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Resources/NEO.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Core/NEO.Core.csproj" />
    <ProjectReference Include="../Infrastructure/NEO.Infrastructure.csproj" />
    <ProjectReference Include="../../tools/ServerHost/NEO.ServerHost.csproj" ReferenceOutputAssembly="false" />
    <Resource Include="Resources/NEO.ico" />
    <Resource Include="Resources/NEO.png" />
  </ItemGroup>
  <Target Name="CopyServerHost" AfterTargets="Build">
    <ItemGroup><ServerHostFiles Include="../../tools/ServerHost/bin/$(Configuration)/net10.0-windows/NEO.ServerHost.*" /></ItemGroup>
    <Copy SourceFiles="@(ServerHostFiles)" DestinationFolder="$(OutDir)" SkipUnchangedFiles="true" />
  </Target>
  <Target Name="PublishServerHost" AfterTargets="Publish">
    <MSBuild Projects="../../tools/ServerHost/NEO.ServerHost.csproj" Targets="Publish" Properties="Configuration=$(Configuration);RuntimeIdentifier=win-x64;SelfContained=true;PublishDir=$(PublishDir);DebugType=None;DebugSymbols=false" />
  </Target>
  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.6.0" />
  </ItemGroup>
</Project>
