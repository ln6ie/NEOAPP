<Window x:Class="NEO.Views.ConversationWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:NEO.Views"
    Title="محادثة" Width="660" Height="560" WindowStyle="None" AllowsTransparency="True" Background="Transparent" BorderThickness="0" ShowInTaskbar="True" ResizeMode="CanResizeWithGrip" MinWidth="380" MinHeight="280" WindowStartupLocation="CenterScreen"
    FontFamily="Segoe UI Variable, Segoe UI" Language="ar-IQ" FlowDirection="RightToLeft" Foreground="{DynamicResource Foreground}" UseLayoutRounding="True" KeyDown="HandleKey" AllowDrop="True" DragOver="DragFiles" Drop="DropFiles">
  <Window.Resources>
    <Style x:Key="EdgeScroller" TargetType="ScrollViewer">
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollViewer">
        <Grid FlowDirection="LeftToRight">
          <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
          <ScrollContentPresenter x:Name="PART_ScrollContentPresenter" CanContentScroll="{TemplateBinding CanContentScroll}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />
          <ScrollBar x:Name="PART_VerticalScrollBar" Grid.Column="1" Orientation="Vertical" Minimum="0" Maximum="{TemplateBinding ScrollableHeight}" ViewportSize="{TemplateBinding ViewportHeight}" Value="{TemplateBinding VerticalOffset}" Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" Width="{DynamicResource {x:Static SystemParameters.VerticalScrollBarWidthKey}}" />
        </Grid>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <RadialGradientBrush x:Key="StatusMist" Center="0.5,0" GradientOrigin="0.5,0" RadiusX="0.5" RadiusY="1">
      <GradientStop Color="#EEFFFFFF" Offset="0" /><GradientStop Color="#55FFFFFF" Offset="0.45" /><GradientStop Color="#00FFFFFF" Offset="1" />
    </RadialGradientBrush>
    <Style x:Key="BareIcon" TargetType="Button">
      <Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinWidth" Value="0" /><Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
      <Setter Property="FontSize" Value="16" /><Setter Property="Foreground" Value="{DynamicResource Foreground}" />
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border Background="Transparent" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.65" /></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter Property="Opacity" Value="0.4" /></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.35" /></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
  </Window.Resources>
  <Window.Template><ControlTemplate TargetType="{x:Type Window}"><AdornerDecorator><ContentPresenter /></AdornerDecorator></ControlTemplate></Window.Template>
  <Border x:Name="Surface" FlowDirection="LeftToRight" Background="{DynamicResource Surface}" CornerRadius="24" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" Padding="0">
    <Border.RenderTransform><TranslateTransform /></Border.RenderTransform>
    <Grid>
      <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
      <Grid Panel.ZIndex="1" VerticalAlignment="Top" Height="62" IsHitTestVisible="False" AutomationProperties.Name="{Binding ConnectionLabel}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.2*" /><ColumnDefinition Width="0.8*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Grid.ColumnSpan="2" Height="52" VerticalAlignment="Top" Background="{Binding ConnectionBrush}" Opacity="0.24" OpacityMask="{StaticResource StatusMist}" Margin="8,0,40,0" />
        <Border Grid.Column="1" Grid.ColumnSpan="2" Height="36" VerticalAlignment="Top" Background="{Binding ConnectionBrush}" Opacity="0.38" OpacityMask="{StaticResource StatusMist}" Margin="30,0,8,0" />
        <Border Grid.Column="1" Height="60" VerticalAlignment="Top" Background="{Binding ConnectionBrush}" Opacity="0.13" OpacityMask="{StaticResource StatusMist}" />
      </Grid>
      <Grid Panel.ZIndex="10" FlowDirection="LeftToRight" VerticalAlignment="Top" Margin="20,12,20,0">

        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
<Border Grid.ColumnSpan="2" Height="32" Background="Transparent" MouseLeftButtonDown="DragWindow" />
        <Image MouseLeftButtonDown="DragWindow" ToolTip="اسحب لتحريك المحادثة" x:Name="HeaderLogo" Grid.Column="1" Source="/NEO;component/Resources/NEO.png" Width="32" Height="32" HorizontalAlignment="Right"><Image.Clip><EllipseGeometry Center="16,16" RadiusX="16" RadiusY="16" /></Image.Clip></Image>
        <Border x:Name="HeaderActions" Background="{DynamicResource CardSurface}" CornerRadius="22" Padding="12,6"><StackPanel Orientation="Horizontal">
<Button Style="{StaticResource BareIcon}" Width="36" Height="30" Padding="6" Click="Dismiss" Content="&#xE711;" ToolTip="إخفاء المحادثة" AutomationProperties.Name="إخفاء المحادثة" />
          <Button Style="{StaticResource BareIcon}" Width="36" Height="30" Padding="6" Click="Minimize" Content="&#xE921;" ToolTip="تصغير المحادثة" AutomationProperties.Name="تصغير المحادثة" />
          <Button Style="{StaticResource BareIcon}" Width="36" Height="30" Padding="6" Click="ToggleVoice" Content="{Binding MicrophoneGlyph}" ToolTip="تشغيل الميكروفون أو إيقافه" AutomationProperties.Name="الميكروفون" Margin="0,0,4,0" />
          <Button Style="{StaticResource BareIcon}" Width="36" Height="30" Padding="6" Click="OpenSettings" Content="&#xE713;" ToolTip="الإعدادات" AutomationProperties.Name="الإعدادات" Margin="0,0,4,0" />
        </StackPanel></Border>
      </Grid>
      <Grid x:Name="ChatArea" Grid.RowSpan="2">
        <TextBlock x:Name="EmptyHint" Text="كيف أستطيع مساعدتك؟" TextAlignment="Center" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
        <TextBlock Text="{Binding ServerStatus}" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,65,0,0" FontSize="11" Opacity="0.7" IsHitTestVisible="False">
          <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding IsServerConnected}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
        </TextBlock>
        <ScrollViewer x:Name="ConversationScroll" Style="{StaticResource EdgeScroller}" FlowDirection="LeftToRight" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel FlowDirection="RightToLeft" Margin="20,58,20,118">
            <ItemsControl ItemsSource="{Binding Conversation}">
              <ItemsControl.ItemTemplate><DataTemplate>
                <Grid Margin="0,4,0,16">
                  <local:MarkdownView x:Name="AssistantReply" Text="{Binding Content}" />
                  <Border x:Name="UserMessage" Visibility="Collapsed" Background="{DynamicResource CardSurface}" CornerRadius="16" Padding="12,8" HorizontalAlignment="Right" MaxWidth="500">
                    <StackPanel><TextBlock Text="{Binding Content}" TextWrapping="Wrap" LineHeight="24" /><ItemsControl ItemsSource="{Binding Attachments}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><local:AttachmentView Attachment="{Binding}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel>
                  </Border>
                </Grid>
                <DataTemplate.Triggers><DataTrigger Binding="{Binding Role}" Value="user"><Setter TargetName="AssistantReply" Property="Visibility" Value="Collapsed" /><Setter TargetName="UserMessage" Property="Visibility" Value="Visible" /></DataTrigger></DataTemplate.Triggers>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
            <local:MarkdownView Text="{Binding LiveResponse}" Margin="0,4,0,12" />
          </StackPanel>
        </ScrollViewer>
      </Grid>
      <StackPanel x:Name="ComposerArea" Grid.RowSpan="2" Panel.ZIndex="20" VerticalAlignment="Bottom" FlowDirection="RightToLeft" Margin="20,10,20,16">
        <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,0,0,6">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate><DataTemplate>
            <Border Background="{DynamicResource CardSurface}" CornerRadius="12" Padding="8,3" Margin="0,0,5,5"><StackPanel Orientation="Horizontal">
              <local:AttachmentView Attachment="{Binding}" />
              <Button Content="&#xE711;" FontFamily="Segoe Fluent Icons" FontSize="10" Padding="4" MinWidth="0" Click="RemoveAttachment" ToolTip="إزالة المرفق" AutomationProperties.Name="إزالة المرفق" Margin="4,0,0,0" />
            </StackPanel></Border>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <TextBlock Text="{Binding AttachmentError}" Foreground="{DynamicResource SecondaryForeground}" FontSize="11" TextWrapping="Wrap" Margin="4,0,4,4" />
        <Border x:Name="Composer" CornerRadius="23" Background="{DynamicResource CardSurface}" BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" Padding="6,5">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Button x:Name="AttachButton" Style="{StaticResource BareIcon}" Width="30" Height="30" Padding="4" MinWidth="0" FontFamily="Segoe Fluent Icons" Content="&#xE710;" Click="AttachFiles" ToolTip="إرفاق ملفات أو صور · أو الصق مباشرة" AutomationProperties.Name="إرفاق ملفات أو صور" VerticalAlignment="Center" />
            <Grid Grid.Column="1">
              <TextBox x:Name="MessageInput" Text="{Binding InputText, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="30" MaxHeight="128" Padding="8,4" FontSize="14" VerticalContentAlignment="Center" KeyDown="HandleInputKey" AutomationProperties.Name="اكتب رسالتك" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" CaretBrush="{DynamicResource BrandBlue}">
                <TextBox.Template><ControlTemplate TargetType="TextBox"><ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" /></ControlTemplate></TextBox.Template>
              </TextBox>
              <TextBlock Text="اكتب رسالتك…" Foreground="{DynamicResource SecondaryForeground}" FontSize="14" Margin="8,3" VerticalAlignment="Center" IsHitTestVisible="False">
                <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding InputText}" Value=""><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
              </TextBlock>
            </Grid>
            <Button x:Name="SendButton" Grid.Column="2" Width="30" Height="30" MinWidth="0" Padding="0" Click="Send" IsEnabled="{Binding CanSend}" ToolTip="إرسال" AutomationProperties.Name="إرسال الرسالة" VerticalAlignment="Center">
              <Button.Template><ControlTemplate TargetType="Button"><Border x:Name="SendCircle" CornerRadius="15" Background="{DynamicResource BrandBlue}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter TargetName="SendCircle" Property="Opacity" Value="0.35" /></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SendCircle" Property="Opacity" Value="0.85" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Button.Template>
              <Path Width="12" Height="14" FlowDirection="LeftToRight" Data="M6,13 L6,1 M1,6 L6,1 L11,6" Stroke="White" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" />
            </Button>
          </Grid>
        </Border>
      </StackPanel>
<DockPanel x:Name="SettingsArea" Grid.RowSpan="2" Visibility="Collapsed" Margin="20,62,20,4">
<Button DockPanel.Dock="Top" Click="BackToChat" Content="الرجوع إلى المحادثة" HorizontalAlignment="Right" Margin="0,0,0,8" Padding="10,5" />
<ContentControl x:Name="SettingsContent" />
</DockPanel>
<ResizeGrip Grid.Row="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="16" Height="16" Margin="0,0,3,-14" ToolTip="تغيير حجم المحادثة" />
    </Grid>
  </Border>
</Window>
